{
  "name": "todos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Todos — a personal, extensible todo PWA. One board on the server, the same on every device.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "typecheck": "tsc -b --noEmit",
    "test:sync": "node scripts/roundtrip.test.mjs",
    "test:db": "tsx scripts/db.test.ts",
    "test:derive": "tsx scripts/derive.test.ts",
    "test:reducer": "tsx scripts/reducer.test.ts",
    "test:copy": "tsx scripts/copy.test.ts",
    "test:store": "tsx scripts/store.test.ts",
    "test:api": "tsx scripts/api.test.ts",
    "test": "npm run test:merge && npm run test:sync && npm run test:syncclient && npm run test:db && npm run test:derive && npm run test:reducer && npm run test:copy && npm run test:composer && npm run test:store && npm run test:api && npm run test:search && npm run test:external && npm run test:serverboard && npm run test:reminders && npm run test:repeat && npm run test:files && npm run test:share && npm run test:readonly && npm run test:windows && npm run test:accounts && npm run test:email && npm run test:ai && npm run test:capture && npm run test:notes && npm run test:tint && npm run test:automations && npm run test:sherlock && npm run test:bot-workspaces && npm run test:appearance",
    "test:merge": "node scripts/merge.test.mjs",
    "test:syncclient": "tsx scripts/sync-client.test.ts",
    "test:search": "tsx scripts/search.test.ts",
    "test:external": "node scripts/external.test.mjs",
    "test:serverboard": "tsx scripts/serverboard.test.ts",
    "test:reminders": "node scripts/reminders.test.mjs",
    "test:repeat": "node scripts/repeat.test.mjs",
    "test:windows": "tsx scripts/twowindows.test.ts",
    "test:files": "node scripts/files.test.mjs",
    "test:share": "node scripts/share.test.mjs",
    "test:readonly": "tsx scripts/readonly.test.ts",
    "test:composer": "tsx scripts/composer.test.ts",
    "test:accounts": "node scripts/accounts.test.mjs",
    "test:email": "node scripts/email-auth.test.mjs",
    "test:ai": "node scripts/assistant.test.mjs",
    "test:capture": "node scripts/capture.test.mjs",
    "test:notes": "node scripts/notes.test.mjs && tsx scripts/notes-layout.test.ts",
    "test:tint": "tsx scripts/tint.test.ts",
    "e2e": "playwright test",
    "test:automations": "node --test scripts/automations.test.mjs scripts/flows.test.mjs",
    "test:sherlock": "node --test scripts/sherlock.test.mjs scripts/sherlock-server.test.mjs",
    "test:bot-workspaces": "node --test scripts/bot-workspaces.test.mjs",
    "test:appearance": "tsx scripts/appearance.test.ts"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "nodemailer": "^10.0.13",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "smtp-server": "^3.19.16",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1"
  }
}
